#!/usr/bin/env bash
# Screenshot: "region" (drag to select) or "screen". Saved to ~/Pictures/Screenshots and copied.
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
f="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case ${1:-region} in
  screen) grim "$f" ;;
  *) area=$(slurp -d) || exit 0; grim -g "$area" "$f" ;;
esac
wl-copy < "$f"
notify-send -a CISA -i "$f" "Screenshot saved" "Copied to the clipboard, saved in Pictures/Screenshots."
