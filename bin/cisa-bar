#!/usr/bin/env bash
# Keep Waybar running for the whole Hyprland session (started by hyprland.conf).
# Waybar can exit if it starts before the compositor/outputs are fully ready, so wait a moment
# for Hyprland, then restart it whenever it exits. Each start is logged for troubleshooting.
log="${XDG_RUNTIME_DIR:-/tmp}/waybar.log"
pgrep -f "bin/cisa-bar" | grep -qv "^$$\$" && exit 0     # already supervised

for _ in $(seq 1 20); do hyprctl monitors >/dev/null 2>&1 && break; sleep 0.5; done
sleep 1
while true; do
  echo "=== $(date '+%F %T') starting waybar" >>"$log"
  waybar >>"$log" 2>&1
  echo "=== $(date '+%F %T') waybar exited ($?)" >>"$log"
  sleep 2
done
