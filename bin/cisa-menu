#!/usr/bin/env python3
"""CISA menu: the app launcher / start menu for the CISA Hyprland desktop (Super key).

A themed card over the desktop: greeting, search, pinned apps, CISA tool categories,
and power buttons. Type to search; arrows + Enter to launch; Esc or a click outside closes.
Styled by ~/.config/cisa-menu/style.css (written by CISA Rice for the current theme).
Pinned apps: ~/.config/cisa-menu/pinned (one .desktop id per line) overrides the defaults.
"""
import datetime as dt
import os
import pathlib
import pwd
import signal
import subprocess
import sys

CONF = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "cisa-menu"
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", pathlib.Path.home() / ".local/share")) / "cisa-rice/current"
PIDFILE = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "cisa-menu.pid"

# Pressing Super again closes the menu
if PIDFILE.exists():
    try:
        os.kill(int(PIDFILE.read_text()), signal.SIGTERM)
        PIDFILE.unlink(missing_ok=True)
        sys.exit(0)
    except (ProcessLookupError, ValueError, PermissionError):
        PIDFILE.unlink(missing_ok=True)

try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell, Pango
except (ImportError, ValueError):
    os.execvp("fuzzel", ["fuzzel"])          # fallback if the GTK bits are missing

PINNED_DEFAULT = [
    "kitty.desktop", "org.kde.dolphin.desktop", "firefox-esr.desktop", "cisa-burpsuite.desktop",
    "org.wireshark.Wireshark.desktop", "cisa-ghidra.desktop", "cisa-cyberchef.desktop", "cisa-metasploit.desktop",
    "cisa-nmap.desktop", "btop.desktop", "systemsettings.desktop", "cisa-welcome.desktop", "cisa-themes.desktop",
]
SHORT_NAMES = {"firefox-esr.desktop": "Firefox", "cisa-burpsuite.desktop": "Burp Suite",
               "cisa-metasploit.desktop": "Metasploit", "cisa-welcome.desktop": "Welcome",
               "cisa-themes.desktop": "Themes", "systemsettings.desktop": "Settings",
               "org.wireshark.Wireshark.desktop": "Wireshark", "btop.desktop": "Monitor", "kitty.desktop": "Terminal",
               "org.kde.dolphin.desktop": "Files"}
# Better icons for security tools: Papirus ships kali-* icons; CISA launchers otherwise share a terminal icon
ICON_OVERRIDES = {"cisa-ghidra.desktop": ["ghidra", "kali-ghidra"], "cisa-metasploit.desktop": ["kali-metasploit-framework", "metasploit"],
                  "cisa-cyberchef.desktop": ["cyberchef", "kali-cyberchef"], "cisa-burpsuite.desktop": ["burpsuite", "kali-burpsuite"],
                  "cisa-john-the-ripper.desktop": ["kali-john", "johnny"], "cisa-sleuth-kit.desktop": ["kali-autopsy", "autopsy"],
                  "cisa-whois-and-dig.desktop": ["kali-whois", "kali-dnsenum"], "cisa-netcat.desktop": ["kali-netcat", "kali-nc"],
                  "btop.desktop": ["btop", "utilities-system-monitor"]}
CATEGORIES = [("Recon", "CISA-Recon"), ("Web", "CISA-Web"), ("Passwords", "CISA-Crypto"),
              ("Exploit", "CISA-Exploit"), ("Forensics", "CISA-Forensics"), ("Reverse", "CISA-Reverse")]


def theme_name():
    env = DATA / "theme.env"
    if env.exists():
        for line in env.read_text().splitlines():
            if line.startswith("NAME="):
                return line.split("=", 1)[1].strip("'\"")
    return ""


def greeting():
    h = dt.datetime.now().hour
    part = "morning" if 5 <= h < 12 else "afternoon" if h < 18 else "evening"
    gecos = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
    name = (gecos or os.environ.get("USER", "")).split(" ")[0]
    return f"Good {part}, {name}" if name else f"Good {part}"


def all_apps():
    apps = [a for a in Gio.AppInfo.get_all() if isinstance(a, Gio.DesktopAppInfo) and a.should_show()]
    seen, out = set(), []
    for a in sorted(apps, key=lambda a: (a.get_display_name() or "").lower()):
        if a.get_id() not in seen:
            seen.add(a.get_id())
            out.append(a)
    return out


def icon_candidates(app):
    aid = app.get_id() or ""
    names = list(ICON_OVERRIDES.get(aid, []))
    if aid.startswith("cisa-"):
        slug = aid[5:].removesuffix(".desktop")
        names += [f"kali-{slug}", slug, f"kali-{slug.split('-')[0]}"]
    return names


def app_icon(app, size):
    img = Gtk.Image()
    theme = Gtk.IconTheme.get_default()
    for name in icon_candidates(app):
        if theme.has_icon(name):
            img.set_from_icon_name(name, Gtk.IconSize.DIALOG)
            img.set_pixel_size(size)
            return img
    gicon = app.get_icon()
    # .ico files (e.g. Ghidra's) render badly in GTK: use a themed icon instead
    if gicon and not (isinstance(gicon, Gio.FileIcon) and gicon.get_file().get_path().endswith(".ico")):
        img.set_from_gicon(gicon, Gtk.IconSize.DIALOG)
    else:
        img.set_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
    img.set_pixel_size(size)
    return img


class Menu(Gtk.Window):
    def __init__(self):
        super().__init__(title="cisa-menu")
        self.apps = all_apps()
        self.by_id = {a.get_id(): a for a in self.apps}
        self.filter_cat = None

        self.set_skip_taskbar_hint(True)       # don't show up as a task in Plasma's panel
        self.set_skip_pager_hint(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self, "cisa-menu")
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.get_style_context().add_class("backdrop")

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.card.get_style_context().add_class("card")
        self.card.set_halign(Gtk.Align.CENTER)
        self.card.set_valign(Gtk.Align.START)
        self.card.set_size_request(700, -1)
        self.card.set_margin_top(64)
        self.add(self.card)

        self.card.pack_start(self.header(), False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search apps and tools")
        self.search.get_style_context().add_class("search")
        self.search.connect("search-changed", self.on_search)
        self.search.connect("activate", self.on_activate)
        self.card.pack_start(self.search, False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=140)
        self.stack.add_named(self.home(), "home")
        self.stack.add_named(self.results_view(), "results")
        self.card.pack_start(self.stack, True, True, 0)
        self.card.pack_start(self.footer(), False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("button-press-event", self.on_click)
        self.connect("destroy", self.quit)
        self.show_all()
        self.search.grab_focus()

    # ---------- sections
    def header(self):
        box = Gtk.Box(spacing=14)
        box.get_style_context().add_class("header")
        icon = DATA / "icon.svg" if (DATA / "icon.svg").exists() else DATA / "icon.png"
        if icon.exists():
            scale = self.get_scale_factor() or 1          # render the vector at the screen's real pixel size
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(icon), 46 * scale, 46 * scale, True)
            surface = Gdk.cairo_surface_create_from_pixbuf(pb, scale, None)
            box.pack_start(Gtk.Image.new_from_surface(surface), False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        g = Gtk.Label(label=greeting(), xalign=0)
        g.get_style_context().add_class("greeting")
        sub = Gtk.Label(label=f"cisa linux  ·  {theme_name().lower()}  ·  learn to hack, legally", xalign=0)
        sub.get_style_context().add_class("sub")
        text.pack_start(g, False, False, 0)
        text.pack_start(sub, False, False, 0)
        box.pack_start(text, True, True, 0)
        for icon_name, tip, cmd in (("emblem-system-symbolic", "Change theme", ["cisa-theme"]),
                                    ("input-keyboard-symbolic", "Keyboard shortcuts", ["cisa-keys"])):
            box.pack_end(self.icon_button(icon_name, tip, cmd), False, False, 0)
        return box

    def home(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.pack_start(self.section_title("Pinned"), False, False, 0)
        flow = Gtk.FlowBox(max_children_per_line=6, min_children_per_line=6, homogeneous=True,
                           selection_mode=Gtk.SelectionMode.NONE, row_spacing=6, column_spacing=6)
        flow.get_style_context().add_class("pinned")
        ids = PINNED_DEFAULT
        if (CONF / "pinned").exists():
            ids = [l.strip() for l in (CONF / "pinned").read_text().splitlines() if l.strip() and not l.startswith("#")]
        for app in [self.by_id[i] for i in ids if i in self.by_id][:12]:
            flow.add(self.tile(app))
        box.pack_start(flow, False, False, 0)

        box.pack_start(self.section_title("CISA tools"), False, False, 0)
        chips = Gtk.FlowBox(max_children_per_line=6, selection_mode=Gtk.SelectionMode.NONE, column_spacing=8, row_spacing=8)
        chips.get_style_context().add_class("chips")
        for label, cat in CATEGORIES:
            b = Gtk.Button(label=label)
            b.get_style_context().add_class("chip")
            b.connect("clicked", lambda _b, c=cat, l=label: self.show_category(c, l))
            chips.add(b)
        box.pack_start(chips, False, False, 0)
        return box

    def results_view(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.results_title = self.section_title("Results")
        box.pack_start(self.results_title, False, False, 0)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.set_min_content_height(330)
        sw.set_max_content_height(330)
        self.results = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
        self.results.get_style_context().add_class("results")
        self.results.connect("row-activated", lambda _l, row: self.launch(row.app))
        sw.add(self.results)
        box.pack_start(sw, True, True, 0)
        return box

    def footer(self):
        box = Gtk.Box(spacing=6)
        box.get_style_context().add_class("footer")
        who = Gtk.Label(label=f"{os.environ.get('USER', '')}@{os.uname().nodename}", xalign=0)
        who.get_style_context().add_class("who")
        box.pack_start(who, True, True, 0)
        in_kde = "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "")
        logout = (["qdbus6", "org.kde.Shutdown", "/Shutdown", "org.kde.Shutdown.logout"] if in_kde
                  else ["hyprctl", "dispatch", "exit"])
        for icon_name, tip, cmd in (("system-shutdown-symbolic", "Shut down", ["systemctl", "poweroff"]),
                                    ("system-reboot-symbolic", "Restart", ["systemctl", "reboot"]),
                                    ("system-log-out-symbolic", "Log out", logout),
                                    ("system-lock-screen-symbolic", "Lock", ["loginctl", "lock-session"])):
            box.pack_end(self.icon_button(icon_name, tip, cmd), False, False, 0)
        return box

    # ---------- widgets
    def section_title(self, text):
        l = Gtk.Label(label=text.upper(), xalign=0)
        l.get_style_context().add_class("section")
        return l

    def icon_button(self, icon_name, tip, cmd):
        b = Gtk.Button.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
        b.set_tooltip_text(tip)
        b.get_style_context().add_class("icon-btn")
        b.connect("clicked", lambda _b: self.run(cmd))
        return b

    def tile(self, app):
        b = Gtk.Button()
        b.get_style_context().add_class("tile")
        b.set_tooltip_text(app.get_description() or app.get_display_name())
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        v.pack_start(app_icon(app, 38), False, False, 0)
        name = Gtk.Label(label=SHORT_NAMES.get(app.get_id(), app.get_display_name()))
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_max_width_chars(11)
        v.pack_start(name, False, False, 0)
        b.add(v)
        b.connect("clicked", lambda _b: self.launch(app))
        return b

    def row(self, app):
        row = Gtk.ListBoxRow()
        row.app = app
        row.get_style_context().add_class("row")
        h = Gtk.Box(spacing=14)
        h.pack_start(app_icon(app, 30), False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        n = Gtk.Label(label=app.get_display_name(), xalign=0)
        n.get_style_context().add_class("name")
        d = Gtk.Label(label=app.get_description() or app.get_generic_name() or "", xalign=0)
        d.get_style_context().add_class("desc")
        d.set_ellipsize(Pango.EllipsizeMode.END)
        v.pack_start(n, False, False, 0)
        v.pack_start(d, False, False, 0)
        h.pack_start(v, True, True, 0)
        row.add(h)
        return row

    # ---------- behaviour
    def fill(self, apps, title):
        for child in self.results.get_children():
            self.results.remove(child)
        for app in apps[:40]:
            self.results.add(self.row(app))
        self.results_title.set_text(f"{title.upper()}  ·  {len(apps)}")
        self.results.show_all()
        first = self.results.get_row_at_index(0)
        if first:
            self.results.select_row(first)
        self.stack.set_visible_child_name("results")

    def on_search(self, entry):
        q = entry.get_text().strip().lower()
        if not q:
            self.filter_cat = None
            self.stack.set_visible_child_name("home")
            return
        scored = []
        for a in self.apps:
            name = (a.get_display_name() or "").lower()
            hay = " ".join(filter(None, [name, (a.get_generic_name() or "").lower(), (a.get_description() or "").lower(),
                                         " ".join(a.get_keywords() or []).lower(), a.get_id().lower()]))
            if q in hay:
                scored.append((0 if name.startswith(q) else 1 if q in name else 2, name, a))
        self.fill([a for _s, _n, a in sorted(scored, key=lambda x: (x[0], x[1]))], "Results")

    def show_category(self, cat, label):
        apps = [a for a in self.apps if cat in (a.get_categories() or "").split(";")]
        self.fill(apps, label)

    def on_activate(self, _entry):
        row = self.results.get_selected_row() or self.results.get_row_at_index(0)
        if self.stack.get_visible_child_name() == "results" and row:
            self.launch(row.app)

    def on_key(self, _w, ev):
        key = ev.keyval
        if key == Gdk.KEY_Escape:
            if self.search.get_text() or self.stack.get_visible_child_name() == "results":
                self.search.set_text("")
                self.stack.set_visible_child_name("home")
                self.search.grab_focus()
            else:
                self.quit()
            return True
        if key in (Gdk.KEY_Down, Gdk.KEY_Up) and self.stack.get_visible_child_name() == "results":
            row = self.results.get_selected_row()
            idx = (row.get_index() if row else -1) + (1 if key == Gdk.KEY_Down else -1)
            nxt = self.results.get_row_at_index(max(idx, 0))
            if nxt:
                self.results.select_row(nxt)
                nxt.grab_focus()
                self.search.grab_focus_without_selecting()
            return True
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.on_activate(None)
            return True
        if not self.search.has_focus() and ev.string and ev.string.isprintable():
            self.search.grab_focus_without_selecting()
            self.search.set_text(self.search.get_text() + ev.string)
            self.search.set_position(-1)
            return True
        return False

    def on_click(self, _w, ev):
        ok, x, y = self.card.translate_coordinates(self, 0, 0)
        a = self.card.get_allocation()
        if not (x <= ev.x <= x + a.width and y <= ev.y <= y + a.height):
            self.quit()
        return False

    def launch(self, app):
        try:
            ctx = Gdk.Display.get_default().get_app_launch_context()
            app.launch([], ctx)
        finally:
            self.quit()

    def run(self, cmd):
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.quit()

    def quit(self, *_):
        PIDFILE.unlink(missing_ok=True)
        Gtk.main_quit()


def main():
    PIDFILE.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: (PIDFILE.unlink(missing_ok=True), Gtk.main_quit()))
    css = Gtk.CssProvider()
    style = CONF / "style.css"
    if style.exists():
        css.load_from_path(str(style))
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    Menu()
    Gtk.main()


if __name__ == "__main__":
    main()
